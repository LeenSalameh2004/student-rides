# Copy to .env and fill in. These values are safe to ship in a client app
# (Firebase web config is public; access is enforced by firestore.rules).
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=

# Google Maps SDK key (enable "Maps SDK for Android" and "Maps SDK for iOS").
# Restrict it to your app's package name / bundle id in Google Cloud Console.
EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=
